# Copy this file to .env and fill in your actual values.

# Required - your self-hosted LiteLLM proxy's address and API key.
LITELLM_BASE_URL="https://YOUR_LITELLM_INSTANCE:4000"
LITELLM_API_KEY="YOUR_SECURE_LITELLM_KEY_ABC123"

# Optional - the model string LiteLLM proxies to (e.g. "qwen3.6:latest").
# Defaults to "qwen3.6:latest" in generator.py if unset.
# Set above _URL and _KEY and run ./getModels.sh, to view models available.
LITELLM_MODEL="qwen3.6:latest"

# Optional - max output tokens per LLM call. Defaults to 10000 if unset.
LITELLM_MAX_TOKENS="10000"

# Optional - Ollama context window size (input + output tokens). Lower
# this if your GPU can't hold the default for the model you're running.
# Defaults to 16384 if unset.
OLLAMA_NUM_CTX="16384"

# Optional - seconds to wait for a single LLM response before giving up
# on that attempt. Defaults to 550 if unset. Raise this if LITELLM_MAX_TOKENS
# and/or OLLAMA_NUM_CTX are large and your hardware is slow enough that a
# full generation legitimately takes longer - but keep it comfortably
# BELOW any reverse proxy's own read timeout in front of LiteLLM (e.g.
# nginx's proxy_read_timeout), or the proxy will silently kill the
# connection first and this setting never gets the chance to matter.
LITELLM_TIMEOUT="550"

# Optional - how long Ollama keeps this model loaded in VRAM after a
# request before unloading it (a duration string like "30m"/"1h", or a
# number of seconds). Defaults to "30m" if unset. A full run makes several
# sequential LLM calls; keeping this comfortably longer than a full run
# takes end to end avoids the model unloading mid-run, which would make
# the next call pay a full model-load penalty on top of generation time.
LITELLM_KEEP_ALIVE="30m"

# Where to write generated resumes/cover letters.
OUTPUT_FOLDER="generated"

# Optional - check generated resumes/cover letters/README into a
# DIFFERENT git repository instead of this one, so this generator repo
# can be decoupled from wherever the generated output actually lives.
# When set, OUTPUT_FOLDER and README_OUTPUT above are both resolved
# INSIDE a local clone of this repo (kept at OUTPUT_REPO_CLONE_DIR)
# rather than in this checkout, and that clone is committed (and,
# unless OUTPUT_REPO_PUSH is "false", pushed) automatically at the end
# of any run that generates a resume, cover letter, and/or README.
# Leave unset (the default) to keep the original behavior -- write
# straight into this checkout, and let you/your CI workflow commit it
# (see .github/workflows/generate.yml). Accepts anything `git clone`
# accepts: an https:// URL, an ssh://... / git@... URL, or a local
# path. KNOWLEDGE_BASE_DRAFT is NOT affected by this -- it's the
# source-of-truth knowledge base everything else is generated FROM, not
# generated output itself, so it always stays local to this checkout.
# OUTPUT_REPO="https://github.com/YOUR_USERNAME/your-resumes.git"

# Branch to check out/commit/push in OUTPUT_REPO. Defaults to that
# repo's own default branch if unset.
# OUTPUT_REPO_BRANCH=""

# Only used when OUTPUT_REPO is an https:// URL to a private repo. Sent
# as an HTTP Basic auth credential embedded in the clone/fetch/push URL
# (GitHub/GitLab/etc. all accept a personal access token as the
# password with any non-empty username -- "x-access-token" is used
# here, GitHub's own convention). Leave unset for a public repo, or
# when OUTPUT_REPO is an ssh:// URL (use your normal SSH key/ssh-agent
# setup instead -- there's no equivalent embedding for ssh:// URLs).
# OUTPUT_REPO_TOKEN="ghp_..."

# Local folder OUTPUT_REPO is cloned into (and, on later runs, pulled up
# to date in place) so repeated runs reuse the same clone instead of
# re-cloning from scratch every time. Defaults to ".output-repo"
# (already covered by .gitignore) if unset.
OUTPUT_REPO_CLONE_DIR=".output-repo"

# Name/email used for the commit made in OUTPUT_REPO. Defaults to
# "LLM-Career-Coach" / "LLM-Career-Coach@users.noreply.github.com" if
# unset -- set these if you'd rather commits be attributed to a real
# account instead (useful in CI, where no global git identity may be
# configured).
OUTPUT_REPO_AUTHOR_NAME="LLM-Career-Coach"
OUTPUT_REPO_AUTHOR_EMAIL="LLM-Career-Coach@users.noreply.github.com"

# Commit message used when checking generated files into OUTPUT_REPO.
# Only the {datetime.now} / {datetime.now.year} / etc. naming-template
# placeholders (see RESUME_NAMING_TEMPLATE above) make sense here, since
# a commit isn't per-resume-variant.
OUTPUT_REPO_COMMIT_MESSAGE="Regenerate resumes/cover letters ({datetime.now})"

# Whether to `git push` after committing to OUTPUT_REPO. Defaults to
# "true". Set to "false" to only commit locally in OUTPUT_REPO_CLONE_DIR
# -- e.g. to review the diff yourself before pushing it on -- without
# skipping the commit itself.
OUTPUT_REPO_PUSH="true"

# Path (or http(s) URL, e.g. a raw file URL into a private repo) to the
# knowledge base JSON that drives generation.
KNOWLEDGE_BASE="data/profile.json"

# Only used when KNOWLEDGE_BASE above is a URL pointing at a private
# source (e.g. a private GitHub repo's raw file URL). Sent as
# "Authorization: token <value>", GitHub's convention -- works for both
# api.github.com and raw.githubusercontent.com with a personal access
# token. Leave unset for a public URL.
# KNOWLEDGE_BASE_URL_TOKEN="ghp_..."

# Path (also a naming template -- see RESUME_NAMING_TEMPLATE below) to
# where knowledge base updates are saved. (Requires RW access.) For a
# single stable file, recommend pointing at KNOWLEDGE_BASE. To keep a
# dated history instead, nest it under a folder placeholder instead,
# e.g. KNOWLEDGE_BASE_DRAFT="data/{datetime.now}/profile.json" -- the
# folder is created automatically the first time something writes into
# it. {FirstName}/{LastName}/{Email} are only available here once
# KNOWLEDGE_BASE already has SOME personal_info to read a name from (a
# from-scratch build, before any name is known yet, renders them "").
# Always a local path, even when KNOWLEDGE_BASE above is a URL -- there's
# no way to push a draft back to an arbitrary URL.
KNOWLEDGE_BASE_DRAFT="data/profile.json"

# Folder --generate profile reads source files (pdf/txt/json/xml/docx)
# from, and uses (via LiteLLM) to build or non-destructively update
# KNOWLEDGE_BASE's draft. Not used by any other --generate target. If this
# is unset, --generate profile is a no-op.
DATA="data"

# GitHub profile README: template to fill in, and where to write the result.
README_TEMPLATE="README.template.md"
README_OUTPUT="README.md"

# Optional "plus addressing" tag (RFC 5233 subaddressing, e.g. Gmail/
# Outlook/etc. honor it) for the README's email mailto: link ONLY -- the
# email address as displayed on the page is never changed. If set, e.g.
# to "resume", personal_info.email "jane@example.com" becomes
# "jane+resume@example.com" inside the mailto: link, so you can tell
# whether a reply/contact came from someone who found you via the
# README. Leave blank (the default) to insert no tag at all -- the
# mailto: link then just matches the displayed email exactly.
EMAIL_TAG_ADDRESS="githubcom-profile"

# Resume template to fill in.
RESUME_TEMPLATE="RESUME.template.md"

# Output filename patterns -- also called "naming templates": each is
# filled in with this run's actual values, and may nest the result under
# a subfolder (created automatically if it doesn't exist yet) by putting
# a placeholder before a "/", e.g. using {JobAcronym} as a per-variant
# subfolder instead of putting it in the filename itself:
#   RESUME_NAMING_TEMPLATE="{JobAcronym}/{FirstName} {LastName} Resume.{Extension}"
#   COVERLETTER_NAMING_TEMPLATE="{JobAcronym}/{FirstName} {LastName} Cover Letter.{Extension}"
# See USAGE.md's "Naming template placeholders" section for the full
# list of what's available ({FirstName}, {LastName}, {JobAcronym},
# {Extension}, {Email}, {datetime.now} and its .year/.month/.day/.hour/
# .minute/.second, etc.) and which of them apply to which setting.
RESUME_NAMING_TEMPLATE="{JobAcronym}/{FirstName} {LastName} Resume ({JobAcronym}).{Extension}"
COVERLETTER_NAMING_TEMPLATE="{JobAcronym}/{FirstName} {LastName} Cover Letter ({JobAcronym}).{Extension}"

# Output filename pattern for --analyze's report (job-fit percentage,
# missing skills/qualifications, and upskill resources against the job
# description passed as --analyze's value). No {JobAcronym} placeholder,
# since analyze isn't per-resume-variant.
ANALYSIS_NAMING_TEMPLATE="{FirstName} {LastName} Job Fit Analysis.{Extension}"

# --analyze's LLM prompt template (a string.Template using
# $output_rules/$candidate_data/$job_description placeholders).
ANALYSIS_PROMPT_TEMPLATE="ANALYSIS_PROMPT.template.txt"